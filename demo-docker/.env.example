# {json:scada} docker demo - environment file
#
# Copy this file to ".env" and fill in JS_JWT_SECRET, or simply run
#
#     ./generate-env.sh        (Linux / macOS)
#     .\generate-env.ps1       (Windows PowerShell)
#
# which creates ".env" with a freshly generated random secret.
# Docker Compose reads ".env" automatically from this folder.
# Never commit your ".env" file.

# Secret used by server_realtime_auth to sign and verify the JWT session
# tokens. It MUST be unique per installation and kept private: anyone who
# knows it can forge an admin token and thereby issue commands to field
# devices, read files and restart processes on the server.
# Use at least 32 random characters.
JS_JWT_SECRET=

# Host address the demo ports are published on. The default binds every
# published port to the loopback interface only, so the demo is reachable
# from this machine alone.
# Change it to 0.0.0.0 (or a specific interface address) ONLY if you really
# want the demo reachable from the network, and be aware that this demo runs
# MongoDB and PostgreSQL WITHOUT AUTHENTICATION and exposes protocol servers
# (IEC 60870-5-104, DNP3, OPC-UA) with no access control.
JS_BIND_ADDR=127.0.0.1
