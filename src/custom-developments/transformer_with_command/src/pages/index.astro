---
import Layout from '../layouts/Layout.astro'
import { TransformerCard } from '../components/TransformerCard'
import '@/styles/globals.css'
---

<Layout title="KAW2 TR1 — Transformer Monitoring and Control">
  <main class="mx-auto w-full max-w-[1080px] px-4 py-6">
    <header class="mb-5 flex flex-wrap items-end justify-between gap-3">
      <div>
        <p
          class="text-[10px] uppercase tracking-[0.18em] text-ink-3"
        >
          {'{json:scada}'} · custom development
        </p>
        <h1 class="mt-1 text-xl font-semibold tracking-tight text-ink-1">
          Transformer Monitoring and Control
        </h1>
      </div>
      <a
        href="/"
        class="text-xs text-ink-3 underline-offset-4 hover:text-ink-1 hover:underline"
      >
        Back to {'{json:scada}'}
      </a>
    </header>

    <TransformerCard client:only="react" />

    <footer class="mt-6 text-[11px] text-ink-3">
      Data served over the {'{json:scada}'} OPC Web HMI API (<code>/Invoke/</code>).
    </footer>
  </main>
</Layout>
